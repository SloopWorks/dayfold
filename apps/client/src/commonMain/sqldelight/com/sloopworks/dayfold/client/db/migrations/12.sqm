-- Migration v12→v13 (ADR 0064): the canonical subjectKey grammar changed its node separators
-- from "/sec:"/"/blk:" to "/section:"/"/block:" so the client and the API build byte-identical
-- keys (a rule minted here is matched server-side by string equality).
--
-- surfacing_state is keyed by that string and is deliberately PRESERVED across a resync — it
-- is device-local anti-nag history, not synced content — so a CLIENT_SCHEMA_VERSION bump would
-- not heal it. Rewrite the keys in place instead: dismissals and last-shown clocks survive the
-- rename, which is the whole point of keeping that table across resyncs.
--
-- No PRIMARY KEY conflict is possible: the old and new shapes are disjoint string sets.
-- No DDL — the .sq schema is unchanged, so this is a data-only migration.
UPDATE surfacing_state
   SET subject_key = replace(replace(subject_key, '/sec:', '/section:'), '/blk:', '/block:')
 WHERE subject_key LIKE '%/sec:%' OR subject_key LIKE '%/blk:%';
