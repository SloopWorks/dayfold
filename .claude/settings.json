{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list:*)",
      "Bash(git rev-parse:*)",
      "Bash(cd apps:*)",
      "Bash(cd apps/api:*)",
      "Bash(cd apps/cli:*)",
      "Bash(./gradlew --version:*)",
      "Bash(./gradlew :client:desktopTest:*)",
      "Bash(./gradlew :ui:desktopTest:*)",
      "Bash(./gradlew :swip-wiring:desktopTest:*)",
      "Bash(./gradlew :ui:snapshotUi:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew build:*)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(npm run codegen:*)",
      "Bash(npm run test:routine-schema:*)",
      "Bash(npm run build:fn:*)",
      "Bash(npm run build:server:*)",
      "Bash(npm run env:check:*)",
      "Bash(npm run db:check:*)",
      "Bash(npm run preflight:*)",
      "Bash(npx vitest run:*)",
      "Bash(bash scripts/check-expect-actual.sh:*)",
      "Bash(bash scripts/check-no-direct-console.sh:*)",
      "Bash(bash scripts/ci-test-failures.sh:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(adb devices:*)",
      "Bash(dayfold --help:*)",
      "Bash(dayfold whoami:*)",
      "Bash(dayfold template:*)",
      "Bash(dayfold content audit:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git tag:*)",
      "Bash(gh release:*)",
      "Bash(vercel deploy:*)",
      "Bash(vercel env:*)",
      "Bash(npm run db:migrate:*)",
      "Bash(dayfold push:*)",
      "Bash(dayfold content apply:*)",
      "Bash(dayfold archive:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./apps/androidApp/google-services.json)",
      "Read(./**/GoogleService-Info.plist)",
      "Edit(./context/values-and-direction.md)",
      "Write(./context/values-and-direction.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/edit-guards.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
